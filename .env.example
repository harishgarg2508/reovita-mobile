# Copy to .env.local and fill in. Never commit .env.local.
# Same names as .env.local. app.config.ts reads them and exposes them to the app through expo-constants.

# Firebase Configuration (mirrored from jinnitask-frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend Base URL (reovita-service). Use your machine's LAN IP on a physical device.
NEXT_PUBLIC_API_BASE_URL=

# Firebase Android config. Never commit the JSON file.
# Paste the whole google-services.json as one line, or base64 of it, or a file path.
GOOGLE_SERVICES_JSON=

# Google Sign-In web client ID (GOOGLE_WEB_CLIENT_ID in the app).
# Do not set it here. app.config.ts reads the client_type 3 entry from google-services.json.
# The file must come from the same Firebase project as NEXT_PUBLIC_FIREBASE_PROJECT_ID,
# and Google sign-in must be enabled in that project's Authentication settings.

# iOS Firebase config. Full GoogleService-Info.plist contents, base64 of it, or a file path.
# Never commit the plist. Used by app.config.ts for the iOS build.
GOOGLE_SERVICE_INFO_PLIST=

# Release signing for CI (GitHub Actions secrets). Local builds ignore these and use the debug key.
# REOVITA_RELEASE_STORE_FILE is set by the workflow itself (/tmp/release.keystore).
REOVITA_RELEASE_STORE_FILE=
REOVITA_RELEASE_STORE_PASSWORD=
REOVITA_RELEASE_KEY_ALIAS=reovita
REOVITA_RELEASE_KEY_PASSWORD=