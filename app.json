{
  "expo": {
    "name": "Reovita",
    "slug": "reovita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon/sprout-icon.png",
    "scheme": "reovita",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6F3F",
        "foregroundImage": "./assets/images/app-icon/sprout-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reovita.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/app-icon/reovita-logo.png",
          "imageWidth": 120
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-camera",
        {
          "cameraPermission": "Reovita uses the camera to photograph your lab reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Reovita uses your location to show your local environment briefing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebase": {},
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "05f612c8-791d-4757-90df-f779689ab5b6"
      }
    }
  }
}
